{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023"], "strict": true, "noEmit": true,
    "skipLibCheck": true, "resolveJsonModule": true,
    "types": ["node", "@cloudflare/vitest-plugin/types"]
  },
  "include": ["worker/**/*.ts", "test/**/*.ts", "worker-configuration.d.ts", "vitest.config.ts"]
}
